# =============================================================================
#  Road Warrior — Backend env example
#  Copy to `.env` and fill in real values. Never commit the real `.env`.
# =============================================================================

# ---------- App ----------
APP_ENV=development
APP_NAME="Road Warrior"
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api
DEFAULT_LANGUAGE=en
FRONTEND_BASE_URL=http://localhost:3000

# ---------- Database (REQUIRED) ----------
# Must use postgresql+asyncpg:// and end with ?sslmode=require for Neon
DATABASE_URL=postgresql+asyncpg://roadwarrior:roadwarrior@localhost:5432/roadwarrior

# ---------- Auth / Security (REQUIRED for prod) ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=60
# One-time token to bootstrap the first admin (remove after first admin created)
ADMIN_BOOTSTRAP_TOKEN=

# ---------- CORS ----------
# Comma-separated list. Include your prod frontend URL(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------- Twilio / WhatsApp (PR #4) ----------
# Set WHATSAPP_MODE=mock for local dev — nothing actually gets sent
WHATSAPP_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=

# ---------- Feature flags ----------
ENABLE_REFERRAL_PROGRAM=true
ENABLE_WHATSAPP_BOT=false
ENABLE_ADMIN_DASHBOARD=true
